{
  "manifest_version": 3,
  "offline_enabled": true,
  "name": "清爽标签页",
  "description": "一个干净、可扩展的新标签页扩展前端模板。",
  "version": "0.1.0",
  "permissions": ["storage"],
  "action": {
    "default_icon": "icons/128x128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/16x16.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
