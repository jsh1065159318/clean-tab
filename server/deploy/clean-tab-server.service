# 清爽标签页同步后端 —— systemd 服务单元
#
# 安装：
#   sudo cp deploy/clean-tab-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now clean-tab-server
#
# 按实际路径修改 User、WorkingDirectory、EnvironmentFile 与 ExecStart 中的 node 路径
# （用 `which node` 确认，nvm 环境下通常是 /home/<user>/.nvm/versions/node/<ver>/bin/node）。

[Unit]
Description=清爽标签页同步后端
Documentation=file:///opt/clean-tab/server/README.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=clean-tab
Group=clean-tab
WorkingDirectory=/opt/clean-tab/server
EnvironmentFile=/opt/clean-tab/server/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5

# 基础加固：禁止提权、隔离 /tmp 与 /home、文件系统只读（仅允许写入自身目录）
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/clean-tab/server
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=clean-tab-server

[Install]
WantedBy=multi-user.target
