# 服务监听地址。默认只监听回环地址，生产环境请通过反向代理（Nginx/Caddy）对外提供 HTTPS。
HOST=127.0.0.1
PORT=8787

# PostgreSQL 连接串。数据库需为 PostgreSQL 13 及以上。
DATABASE_URL=postgres://clean_tab:change-me@127.0.0.1:5432/clean_tab

# 连接池上限。
DB_POOL_MAX=10

# 登录会话有效期（天）。到期后需要重新登录。
SESSION_DAYS=90

# 是否开放注册。设为 false 后 /auth/signup 会返回 403，适合只允许自己使用的部署。
SIGNUP_ENABLED=true

# 允许的跨域来源，逗号分隔。
# 浏览器扩展页面的 Origin 形如 chrome-extension://<id> 或 moz-extension://<id>，默认已放行。
# 如需额外放行自有前端域名，在此追加；填 * 表示放行全部来源。
CORS_ORIGINS=

# 扩展构建产物目录，落地页据此提供安装包下载。默认取仓库根目录下的 build/。
# 仅当构建产物不在默认位置（例如独立部署后端时）才需要设置。
# EXTENSION_DIR=/opt/clean-tab/build
