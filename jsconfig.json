{
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "baseUrl": "src",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "checkJs": false,
    "paths": {
      "@/*": ["./*"],
      "assets/*": ["./assets/*"],
      "constants/*": ["./constants/*"],
      "config/*": ["./config/*"],
      "features/*": ["./features/*"],
      "lib/*": ["./lib/*"],
      "repositories/*": ["./repositories/*"],
      "services/*": ["./services/*"],
      "utils/*": ["./utils/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "build"]
}
